{
  "name": "pickdot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name pickdot --branch main",
    "deploy:hf": "npm run build && python scripts/deploy-hf.py"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wrangler": "^4.141.0"
  },
  "license": "UNLICENSED"
}
